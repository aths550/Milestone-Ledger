# Soroban RPC endpoint. Use the public testnet RPC unless you're running your own.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase must match the network you deployed to.
# Testnet: "Test SDF Network ; September 2015"
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Fill these in after running scripts/deploy.sh (or the manual steps in README.md).
VITE_ESCROW_CONTRACT_ID=
VITE_REPUTATION_CONTRACT_ID=
